generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid(7)) @db.Uuid
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
  deployments  Deployment[]
}

model Organization {
  id                  String               @id @default(uuid(7)) @db.Uuid
  name                String
  createdAt           DateTime             @default(now())
  memberships         Membership[]
  githubInstallations GitHubInstallation[]
  projects            Project[]
  slackWebhook        String?
  alerts              Alert[]
}

enum Role {
  owner
}

model Membership {
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           Role
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

model Session {
  tokenHash String   @id
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GitHubInstallation {
  installationId BigInt
  accountLogin   String
  organizationId String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([installationId, organizationId])
  @@index([organizationId])
}

model Project {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  createdAt      DateTime     @default(now())
  deletingAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services       Service[]

  @@unique([organizationId, name])
}

enum ServiceType {
  web
}

enum BuildMethod {
  dockerfile
}

model Service {
  id                 String         @id @default(uuid(7)) @db.Uuid
  projectId          String         @db.Uuid
  name               String
  type               ServiceType
  repositoryId       BigInt
  repositoryFullName String
  branch             String
  sourceDirectory    String
  buildMethod        BuildMethod
  port               Int
  healthCheckPath    String         @default("/health/ready")
  envVars            String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletingAt         DateTime?
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployments        Deployment[]
  metrics            MetricSample[]

  @@unique([projectId, name])
}

enum DeploymentStatus {
  queued
  running
  succeeded
  failed
}

enum DeploymentTrigger {
  manual
  rollback
  auto_rollback
}

enum StepStatus {
  running
  succeeded
  failed
}

model Deployment {
  id              String            @id @default(uuid(7)) @db.Uuid
  serviceId       String            @db.Uuid
  activeServiceId String?           @unique @db.Uuid
  status          DeploymentStatus  @default(queued)
  trigger         DeploymentTrigger
  triggeredById   String?           @db.Uuid
  idempotencyKey  String
  rollbackOfId    String?           @db.Uuid
  port            Int?
  healthCheckPath String?
  commitSha       String?
  image           String?
  url             String?
  error           String?
  watchUntil      DateTime?
  watchFailures   Int               @default(0)
  failedAfterLive String?
  createdAt       DateTime          @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  triggeredBy     User?             @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  rollbackOf      Deployment?       @relation("Rollback", fields: [rollbackOfId], references: [id], onDelete: SetNull)
  rollbacks       Deployment[]      @relation("Rollback")
  steps           DeploymentStep[]
  alerts          Alert[]

  @@unique([serviceId, idempotencyKey])
  @@index([serviceId, createdAt])
  @@index([watchUntil])
}

model DeploymentStep {
  id           String     @id @default(uuid(7)) @db.Uuid
  deploymentId String     @db.Uuid
  name         String
  status       StepStatus @default(running)
  error        String?
  log          String?
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, name])
}

model Outbox {
  id        BigInt    @id @default(autoincrement())
  type      String
  payload   Json
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([sentAt])
}

model MetricSample {
  id           BigInt   @id @default(autoincrement())
  serviceId    String   @db.Uuid
  deploymentId String   @db.Uuid
  cpuPercent   Float
  memoryBytes  BigInt
  memoryLimit  BigInt
  takenAt      DateTime @default(now())
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, takenAt])
  @@index([takenAt])
}

enum AlertKind {
  deploy_failed
  broke_after_live
  test
}

model Alert {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  deploymentId   String?      @db.Uuid
  kind           AlertKind
  title          String
  message        String
  emailedAt      DateTime?
  slackedAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deployment     Deployment?  @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
