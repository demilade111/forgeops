generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid(7)) @db.Uuid
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
  deployments  Deployment[]
}

model Organization {
  id                  String               @id @default(uuid(7)) @db.Uuid
  name                String
  createdAt           DateTime             @default(now())
  memberships         Membership[]
  githubInstallations GitHubInstallation[]
  projects            Project[]
}

enum Role {
  owner
}

model Membership {
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           Role
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

model Session {
  tokenHash String   @id
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GitHubInstallation {
  installationId BigInt       @id
  accountLogin   String
  organizationId String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Project {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services       Service[]

  @@unique([organizationId, name])
}

enum ServiceType {
  web
}

enum BuildMethod {
  dockerfile
}

model Service {
  id                 String       @id @default(uuid(7)) @db.Uuid
  projectId          String       @db.Uuid
  name               String
  type               ServiceType
  repositoryId       BigInt
  repositoryFullName String
  branch             String
  sourceDirectory    String
  buildMethod        BuildMethod
  port               Int
  envVars            String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployments        Deployment[]

  @@unique([projectId, name])
}

enum DeploymentStatus {
  queued
  running
  succeeded
  failed
}

enum DeploymentTrigger {
  manual
}

enum StepStatus {
  running
  succeeded
  failed
}

model Deployment {
  id              String            @id @default(uuid(7)) @db.Uuid
  serviceId       String            @db.Uuid
  activeServiceId String?           @unique @db.Uuid
  status          DeploymentStatus  @default(queued)
  trigger         DeploymentTrigger
  triggeredById   String?           @db.Uuid
  idempotencyKey  String
  commitSha       String?
  image           String?
  url             String?
  error           String?
  createdAt       DateTime          @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  triggeredBy     User?             @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  steps           DeploymentStep[]

  @@unique([serviceId, idempotencyKey])
  @@index([serviceId, createdAt])
}

model DeploymentStep {
  id           String     @id @default(uuid(7)) @db.Uuid
  deploymentId String     @db.Uuid
  name         String
  status       StepStatus @default(running)
  error        String?
  log          String?
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, name])
}

model Outbox {
  id        BigInt    @id @default(autoincrement())
  type      String
  payload   Json
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([sentAt])
}
